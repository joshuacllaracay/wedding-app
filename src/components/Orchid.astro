---
// A spray of ivory orchids with buds and brown leaves, echoing the orchids on the arch.
// Each instance needs its own `id` so its gradients stay unique on the page.
interface Props { id: string; class?: string; }
const { id, class: className = '' } = Astro.props;
const petal = `${id}-petal`, leaf = `${id}-leaf`, lip = `${id}-lip`, flower = `${id}-flower`;
---
<svg class={`orchid-spray ${className}`} viewBox="0 0 260 260" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={petal} cx="40%" cy="38%" r="75%"><stop offset="0" stop-color="#fffdf8" /><stop offset=".62" stop-color="#f6ecdc" /><stop offset="1" stop-color="#dcc3a1" /></radialGradient>
    <linearGradient id={leaf} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b07e55" /><stop offset=".55" stop-color="#7c5337" /><stop offset="1" stop-color="#4e3424" /></linearGradient>
    <radialGradient id={lip} cx="50%" cy="35%" r="70%"><stop offset="0" stop-color="#f3d9a6" /><stop offset="1" stop-color="#b98451" /></radialGradient>
    <symbol id={flower} viewBox="-50 -50 100 100">
      <g fill={`url(#${petal})`} stroke="#c7a888" stroke-width=".7">
        <ellipse cx="0" cy="-24" rx="11" ry="21" />
        <ellipse cx="-13" cy="20" rx="9.5" ry="19" transform="rotate(32 -13 20)" />
        <ellipse cx="13" cy="20" rx="9.5" ry="19" transform="rotate(-32 13 20)" />
        <ellipse cx="-22" cy="-3" rx="22" ry="18" transform="rotate(-14 -22 -3)" />
        <ellipse cx="22" cy="-3" rx="22" ry="18" transform="rotate(14 22 -3)" />
      </g>
      <path d="M-22 -3c8 2 14 4 18 6M22 -3c-8 2-14 4-18 6M0 -40v12" stroke="#e3cdb0" stroke-width=".8" fill="none" />
      <path d="M-8 4c2-6 14-6 16 0 1 8-4 14-8 15-4-1-9-7-8-15z" fill={`url(#${lip})`} />
      <ellipse cx="0" cy="-2" rx="4" ry="5" fill="#fffaf0" />
    </symbol>
  </defs>
  <g fill={`url(#${leaf})`}>
    <path d="M118 236c-30-6-70-30-96-70 34 18 70 34 100 56z" />
    <path d="M126 236c22-24 70-48 120-50-34 14-78 36-112 60z" />
    <path d="M110 230c-12-30-12-70 6-104-2 34 0 70 6 100z" />
  </g>
  <g stroke="#f3e5d0" stroke-width=".8" fill="none" opacity=".5"><path d="M118 234c-30-14-60-36-90-64M128 234c30-22 70-40 110-46" /></g>
  <path d="M120 232c-6-46 0-96 34-150 18-28 38-44 60-52" stroke="#6b4a33" stroke-width="2.4" fill="none" stroke-linecap="round" />
  <path d="M146 96c-20-10-40-10-62 2" stroke="#6b4a33" stroke-width="1.8" fill="none" stroke-linecap="round" />
  <g fill={`url(#${petal})`} stroke="#c7a888" stroke-width=".6">
    <ellipse cx="216" cy="30" rx="6" ry="8" transform="rotate(30 216 30)" />
    <ellipse cx="200" cy="40" rx="8" ry="10" transform="rotate(20 200 40)" />
    <ellipse cx="80" cy="98" rx="7" ry="9" transform="rotate(-30 80 98)" />
  </g>
  <use href={`#${flower}`} x="134" y="44" width="80" height="80" />
  <use href={`#${flower}`} x="96" y="100" width="96" height="96" />
  <use href={`#${flower}`} x="38" y="104" width="70" height="70" />
</svg>
<style>
  .orchid-spray { display: block; pointer-events: none; filter: drop-shadow(0 6px 10px #2e1f1733); }
</style>
