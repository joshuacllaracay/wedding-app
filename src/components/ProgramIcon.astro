---
// Line icons for the program timeline. Add a new name here to use it in wedding.ts.
interface Props { name?: string }
const { name = 'ceremony' } = Astro.props;
---
<svg class="program-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'assemble' && (<>
    <circle cx="17" cy="15" r="5" /><circle cx="31" cy="15" r="5" />
    <path d="M7 38c0-7 4.5-12 10-12s10 5 10 12" /><path d="M21 38c0-7 4.5-12 10-12s10 5 10 12" />
    <path d="M24 5l1.2 2.6 2.8.3-2.1 1.9.6 2.8L24 11.2l-2.5 1.4.6-2.8L20 7.9l2.8-.3z" stroke-width="1.1" />
  </>)}
  {name === 'ceremony' && (<>
    <circle cx="19" cy="29" r="10" /><circle cx="29" cy="29" r="10" />
    <path d="M16 12l3-5h6l3 5-6 6z" /><path d="M16 12h12" />
  </>)}
  {name === 'cocktail' && (<>
    <path d="M9 13h12l-6 9z" /><path d="M15 22v13" /><path d="M11 35h8" />
    <path d="M27 13h12l-6 9z" /><path d="M33 22v13" /><path d="M29 35h8" />
    <path d="M21 9l3-3 3 3" /><circle cx="36" cy="10" r="2.2" />
  </>)}
  {name === 'reception' && (<>
    <path d="M8 32a16 16 0 0 1 32 0z" /><path d="M5 32h38" /><path d="M24 14v2" /><circle cx="24" cy="12.5" r="1.6" />
    <path d="M11 38h26" />
  </>)}
</svg>
