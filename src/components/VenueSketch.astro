---
// Hand-drawn style line sketch of a Spanish-hacienda hotel (Montebello Hotel, Cebu),
// generated as SVG strokes so it can "draw itself" when scrolled into view.
// It is an artistic interpretation of the venue's style, not an architectural drawing.
interface Props { class?: string; label?: string }
const { class: className = '', label = 'Sketch of the wedding venue' } = Astro.props;

// Deterministic randomness so the drawing is identical on every build.
let seed = 20270612;
const rand = () => { seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
const j = (v: number, a = 0.9) => +(v + (rand() - 0.5) * 2 * a).toFixed(1);

type Stroke = { d: string; w: number; o: number; delay: number };
const strokes: Stroke[] = [];
let group = 0, groupStart = 0;
const phase = (start: number) => { groupStart = start; group = 0; };
const add = (d: string, w = 1.1, o = 0.9) => { strokes.push({ d, w, o, delay: +(groupStart + group * 0.012 + rand() * 0.05).toFixed(2) }); group++; };

// A slightly wobbly line that overshoots its ends a little, like a pencil stroke.
const line = (x1: number, y1: number, x2: number, y2: number, w = 1.1, o = 0.9) => {
  const dx = x2 - x1, dy = y2 - y1, len = Math.hypot(dx, dy) || 1, over = Math.min(3, len * 0.04);
  const ux = dx / len, uy = dy / len;
  add(`M${j(x1 - ux * over)} ${j(y1 - uy * over)} Q${j((x1 + x2) / 2, 1.4)} ${j((y1 + y2) / 2, 1.4)} ${j(x2 + ux * over)} ${j(y2 + uy * over)}`, w, o);
};
const box = (x: number, y: number, w: number, h: number, sw = 1.1) => { line(x, y, x + w, y, sw); line(x + w, y, x + w, y + h, sw); line(x + w, y + h, x, y + h, sw); line(x, y + h, x, y, sw); };
const arch = (x: number, base: number, w: number, h: number, sw = 1.1) => {
  const r = w / 2, top = base - h + r;
  add(`M${j(x)} ${j(base)} L${j(x)} ${j(top)} A${r} ${r} 0 0 1 ${j(x + w)} ${j(top)} L${j(x + w)} ${j(base)}`, sw);
};
const hatch = (x1: number, y1: number, x2: number, y2: number, gap = 6, slant = 5, o = 0.45) => {
  for (let x = x1 + gap / 2; x < x2; x += gap) line(x, y1, x - slant, y2, 0.6, o);
};
// Shade the inside of an arch with short vertical strokes.
const archShade = (x: number, base: number, w: number, h: number) => {
  const r = w / 2, top = base - h + r;
  for (let x0 = x + 3; x0 < x + w - 2; x0 += 4) {
    const dx = x0 - (x + r), yTop = top - Math.sqrt(Math.max(0, r * r - dx * dx)) + 3;
    line(x0, yTop, x0 - 1, base - 1, 0.55, 0.4);
  }
};
const tiles = (xl: number, xr: number, yTop: number, yBot: number, inset: number, gap = 8) => {
  // Roof tile ribs following the hip roof slope.
  for (let x = xl + inset; x <= xr - inset; x += gap) line(x, yTop + 1, x + (x - (xl + xr) / 2) * 0.08, yBot - 2, 0.55, 0.5);
  line(xl + inset * 0.5, (yTop + yBot) / 2, xr - inset * 0.5, (yTop + yBot) / 2, 0.55, 0.45);
};
const windowW = (x: number, y: number, w = 20, h = 26) => {
  box(x, y, w, h, 0.9); line(x + w / 2, y, x + w / 2, y + h, 0.6, 0.6); line(x - 2, y + h + 2, x + w + 2, y + h + 2, 0.9);
  hatch(x + 1, y + 2, x + w / 2 - 1, y + h - 2, 3, 2, 0.35);
};
const palm = (x: number, base: number, height: number, lean: number) => {
  const tx = x + lean, ty = base - height;
  add(`M${x - 4} ${base} Q${x + lean * 0.3 - 3} ${base - height * 0.55} ${tx - 2} ${ty}`, 1);
  add(`M${x + 4} ${base} Q${x + lean * 0.3 + 4} ${base - height * 0.55} ${tx + 2} ${ty}`, 1);
  for (let k = 1; k < 9; k++) { const yy = base - (height * k) / 9; const xx = x + lean * (k / 9) * (k / 9); line(xx - 3, yy, xx + 3, yy - 1, 0.5, 0.5); }
  for (const [ang, len, droop] of [[-160, 52, 18], [-130, 46, 10], [-100, 34, 4], [-75, 34, 4], [-45, 48, 12], [-15, 54, 20], [170, 44, 22], [10, 46, 24]] as const) {
    const a = (ang * Math.PI) / 180, ex = tx + Math.cos(a) * len, ey = ty + Math.sin(a) * len + droop;
    add(`M${tx} ${ty} Q${j((tx + ex) / 2 + Math.cos(a) * 6)} ${j((ty + ey) / 2 - 10)} ${j(ex)} ${j(ey)}`, 0.9);
    for (let f = 0.25; f < 0.95; f += 0.14) { const fx = tx + (ex - tx) * f, fy = ty + (ey - ty) * f - 6 * Math.sin(f * Math.PI); line(fx, fy, fx + Math.cos(a + 1.2) * 7, fy + 8, 0.5, 0.5); }
  }
};
const shrub = (x1: number, x2: number, base: number, h = 16) => {
  let d = `M${x1} ${base}`; let x = x1;
  while (x < x2) { const w = 10 + rand() * 10, top = base - h * (0.6 + rand() * 0.5); d += ` Q${j(x + w / 2)} ${j(top)} ${j(Math.min(x + w, x2))} ${j(base - 2)}`; x += w; }
  add(d, 0.9, 0.75);
  for (let k = x1 + 4; k < x2; k += 7) line(k, base - 3, k + 2, base - h * 0.5, 0.45, 0.35);
};

const G = 320; // ground line
// 1. Ground and walkway
phase(0);
line(30, G, 870, G, 1.2); line(60, G + 6, 840, G + 6, 0.6, 0.4);
line(420, G, 330, 372, 0.8, 0.6); line(480, G, 570, 372, 0.8, 0.6);
for (let k = 0; k < 6; k++) line(395 - k * 14, G + 10 + k * 9, 505 + k * 14, G + 10 + k * 9, 0.45, 0.3);

// 2. Wings: walls, floor line, arcade, upper windows
phase(0.35);
for (const [x0, x1] of [[120, 360], [540, 780]]) {
  line(x0, 215, x0, G); line(x1, 215, x1, G); line(x0, 266, x1, 266, 0.8); line(x0, 215, x1, 215);
  for (let k = 0; k < 5; k++) { const ax = x0 + 18 + k * 44; arch(ax, G, 32, 46); }
  for (let k = 0; k < 5; k++) windowW(x0 + 24 + k * 44, 228);
}

// 3. Central block, balcony and grand entrance
phase(0.9);
line(360, 168, 360, G, 1.3); line(540, 168, 540, G, 1.3);
arch(420, G, 60, 92, 1.3); arch(428, G, 44, 80, 0.7);
line(400, 214, 500, 214, 1); line(400, 228, 500, 228, 0.9);
for (let x = 404; x <= 496; x += 8) line(x, 214, x, 228, 0.5, 0.6);
arch(432, 212, 36, 34, 1);
windowW(375, 180, 18, 24); windowW(507, 180, 18, 24); windowW(375, 250, 18, 26); windowW(507, 250, 18, 26);
for (let k = 0; k < 3; k++) line(410 - k * 6, G - 4 - k * 0, 490 + k * 6, G - 4, 0.6, 0.6);

// 5. Roofs with tiles
phase(1.8);
for (const [x0, x1] of [[120, 360], [540, 780]]) {
  add(`M${x0 - 16} 215 L${x0 + 14} 184 L${x1 - 14} 184 L${x1 + 16} 215`, 1.2);
  tiles(x0 - 6, x1 + 6, 184, 215, 18);
}
add('M348 170 L450 126 L552 170', 1.3); tiles(352, 548, 140, 170, 40, 9);
line(348, 170, 552, 170, 1);

// 4. Bell tower (after the roof in drawing order, so it sits in front of it)
const towerFrom = strokes.length;
phase(1.4);
line(468, 96, 468, 170, 1.2); line(522, 96, 522, 170, 1.2); line(466, 96, 524, 96, 1); line(466, 140, 524, 140, 0.8);
arch(482, 136, 26, 34, 1); archShade(482, 136, 26, 34);
add('M462 96 L495 60 L528 96', 1.1); line(495, 60, 495, 44, 0.9); add('M492 44 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0', 0.8);
hatch(505, 66, 526, 95, 4, 4, 0.4); hatch(512, 142, 522, 168, 3, 1, 0.35);

// 6. Shading under arches and on the right-hand faces
phase(2.3);
for (const [x0] of [[120], [540]]) for (let k = 0; k < 5; k++) archShade(x0 + 18 + k * 44, G, 32, 46);
archShade(428, G, 44, 80);
hatch(744, 218, 778, 264, 5, 4, 0.3); hatch(318, 218, 358, 264, 6, 4, 0.25);

// 7. Palms, shrubs and birds
phase(2.6);
palm(70, G, 150, 22); palm(842, G, 135, -20); palm(102, G, 105, -16);
shrub(115, 360, G, 15); shrub(540, 785, G, 15); shrub(20, 120, G, 22); shrub(790, 880, G, 20);
add('M610 70 q6 -6 12 0 q6 -6 12 0', 0.8, 0.7); add('M650 52 q4 -4 8 0 q4 -4 8 0', 0.7, 0.6); add('M230 90 q5 -5 10 0 q5 -5 10 0', 0.7, 0.6);
---
<svg class={`venue-sketch ${className}`} viewBox="0 0 900 380" role="img" aria-label={label} fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
  {strokes.slice(0, towerFrom).map(s => <path d={s.d} pathLength="1" stroke-width={s.w} opacity={s.o} style={`--d:${s.delay}s`} />)}
  <rect class="sketch-mask" x="467" y="97" width="56" height="72" stroke="none" />
  {strokes.slice(towerFrom).map(s => <path d={s.d} pathLength="1" stroke-width={s.w} opacity={s.o} style={`--d:${s.delay}s`} />)}
</svg>
