---
// A cluster of hanging capiz-style lanterns on thin cords. `side` mirrors the cluster.
interface Props { id: string; side?: 'left' | 'right'; class?: string; }
const { id, side = 'left', class: className = '' } = Astro.props;
const body = `${id}-body`, glow = `${id}-glow`, brass = `${id}-brass`, shape = `${id}-lantern`;
// x, cord length (y of the lantern top), scale
const lanterns = [[44, 70, 1], [104, 150, 0.82], [150, 60, 0.9], [74, 214, 0.66], [178, 128, 0.7]];
---
<svg class={`lanterns ${side} ${className}`} viewBox="0 0 220 320" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={body} cx="45%" cy="45%" r="65%"><stop offset="0" stop-color="#fffaf0" /><stop offset=".55" stop-color="#f4e8d4" /><stop offset="1" stop-color="#cfb592" /></radialGradient>
    <radialGradient id={glow} cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#fff3d6" stop-opacity=".75" /><stop offset="1" stop-color="#fff3d6" stop-opacity="0" /></radialGradient>
    <linearGradient id={brass} x1="0" x2="1"><stop offset="0" stop-color="#8a6248" /><stop offset=".5" stop-color="#c9a682" /><stop offset="1" stop-color="#7a5236" /></linearGradient>
    <symbol id={shape} viewBox="-30 0 60 100" overflow="visible">
      <circle cx="0" cy="44" r="34" fill={`url(#${glow})`} />
      <rect x="-5" y="0" width="10" height="7" rx="2" fill={`url(#${brass})`} />
      <path d="M0 7c16 3 25 18 24 34-1 18-11 30-24 33-13-3-23-15-24-33-1-16 8-31 24-34z" fill={`url(#${body})`} stroke="#c3a27f" stroke-width=".8" />
      <g stroke="#d8c0a0" stroke-width=".7" fill="none"><path d="M0 7v67M-12 11c-6 12-6 46 0 60M12 11c6 12 6 46 0 60M-20 22c-3 14-2 30 2 42M20 22c3 14 2 30-2 42" /><path d="M-23 40h46" opacity=".6" /></g>
      <path d="M-6 74h12l-2 6h-8z" fill={`url(#${brass})`} />
      <path d="M0 80v14" stroke="#b48a64" stroke-width="1.4" stroke-linecap="round" />
    </symbol>
  </defs>
  <g stroke="#a8825f" stroke-width=".9" opacity=".85">
    {lanterns.map(([x, y]) => <path d={`M${x} 0V${y}`} />)}
  </g>
  {lanterns.map(([x, y, s]) => <use href={`#${shape}`} x={x - 30 * s} y={y} width={60 * s} height={100 * s} />)}
</svg>
<style>
  .lanterns { display: block; pointer-events: none; filter: drop-shadow(0 8px 10px #2e1f1726); }
  .lanterns.right { transform: scaleX(-1); }
</style>
