---
import Layout from '../layouts/Layout.astro';
import { wedding } from '../config/wedding';
// Photo sharing moved to /upload. Old /memories?invite=… links keep working by forwarding there.
---
<Layout title={`Share your photos · ${wedding.bride} & ${wedding.groom}`} privatePage>
  <main class="memories-shell">
    <p class="admin-lead">Photo sharing has moved. <a class="text-link" href="/upload">Continue to share your photos →</a></p>
  </main>
  <script is:inline>location.replace('/upload' + location.search);</script>
</Layout>
