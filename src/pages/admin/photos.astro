---
import Layout from '../../layouts/Layout.astro';
import AdminHeader from '../../components/AdminHeader.astro';
import { requireAdmin } from '../../lib/server';
export const prerender = false;
try { await requireAdmin(Astro); } catch { return Astro.redirect('/login'); }
---
<Layout title="Photos · Our wedding portal" privatePage>
  <main class="admin-shell">
    <AdminHeader active="photos" title="Every moment they shared." lead="All the photos your guests uploaded, newest first. Click a photo to see it larger, download originals, or remove one." />
    <div id="memories-admin-status" role="status" aria-live="polite" class="admin-status"></div>
    <div id="cleanup-panel" class="notification-bar" hidden><p><span id="expired-photo-count">0</span> expired or removed uploads can be cleared to return guest photo slots.</p><button class="text-link" id="cleanup-photos">Release expired slots ↗︎</button></div>
    <section class="memory-gallery" aria-labelledby="gallery-title"><div class="admin-toolbar"><div><span class="eyebrow">OUR DAY, THROUGH THEIR EYES</span><h2 id="gallery-title">A collection of little forevers.</h2><p id="gallery-total" class="admin-lead"></p></div><button id="gallery-refresh" class="text-link">Refresh gallery</button></div><div class="gallery-controls"><div><label for="gallery-guest">Photos from</label><select id="gallery-guest"><option value="">Everyone</option></select></div><button id="download-selected" class="button" disabled>Download selected ZIP (0/10)</button></div><p class="admin-lead">Select up to 10 originals per ZIP to keep downloads manageable. Click a photo to view it larger.</p><div id="gallery-grid" class="gallery-grid"></div><p id="gallery-empty" class="empty-state" hidden>Your memories will appear here when guests share their photos.</p><div class="gallery-pagination"><button class="text-link" id="gallery-prev" disabled>← Previous</button><span id="gallery-page"></span><button class="text-link" id="gallery-next" disabled>Next →</button></div></section>
    <section class="admin-card memory-settings" aria-labelledby="memory-settings-title"><div><span class="eyebrow">A LITTLE SOMETHING FOR THE BIG DAY</span><h2 id="memory-settings-title">Open the doors to memories.</h2><p>Guests share photos on a separate page, <a class="text-link" href="/upload" target="_blank" rel="noopener">/upload ↗︎</a>, using their invitation code. It only accepts photos while sharing is open. Schedule it once, or change it here at any time.</p><div class="upload-page-actions"><button type="button" class="text-link" id="upload-page-qr">Photo-sharing page QR ↓</button><button type="button" class="text-link" id="copy-upload-page">Copy page link</button></div><p class="upload-page-hint">For a guest’s own QR with their code filled in, use “Upload QR” in the guest list.</p></div><form id="memory-settings-form"><label for="memory-mode">Photo sharing</label><select id="memory-mode"><option value="closed">Closed — hide the sharing button</option><option value="scheduled">Scheduled — use the dates below</option><option value="open">Open now — until I close it</option></select><div id="memory-schedule" class="form-row" hidden><div><label for="memory-opens">Opens (Singapore time, UTC+08)</label><input type="datetime-local" id="memory-opens" /></div><div><label for="memory-closes">Closes (Singapore time, UTC+08)</label><input type="datetime-local" id="memory-closes" /></div></div><button type="submit" class="button">Save photo-sharing settings <span aria-hidden="true">→</span></button></form></section>
    <dialog id="photo-viewer" class="photo-viewer"><button type="button" id="close-photo-viewer" class="text-link">Close ×</button><img id="photo-viewer-image" alt="" /><p id="photo-viewer-caption"></p><button type="button" id="photo-viewer-download" class="button">Download original ↓</button><button type="button" id="photo-viewer-remove" class="text-link danger-link">Remove photo</button></dialog>
  </main>
  <script src="../../scripts/admin-memories.ts"></script>
</Layout>
