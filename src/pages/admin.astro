---
import Layout from '../layouts/Layout.astro';
import AdminHeader from '../components/AdminHeader.astro';
import { requireAdmin } from '../lib/server';
export const prerender = false;
try { await requireAdmin(Astro); } catch { return Astro.redirect('/login'); }
---
<Layout title="Our wedding portal · Chyka & Emmanuel" privatePage>
  <main class="admin-shell">
    <AdminHeader active="guests" title="A seat for everyone you love." lead="One invitation, up to two people. Responses update the existing invitation so your headcount stays accurate." />
    <div id="dashboard-status" role="status" aria-live="polite" class="admin-status"></div>
    <div class="stats"><div class="stat"><span>Confirmed people</span><strong id="total-guests">—</strong></div><div class="stat"><span>Accepting invitations</span><strong id="total-accepting">—</strong></div><div class="stat"><span>Declined invitations</span><strong id="total-declined">—</strong></div><div class="stat"><span>Awaiting a response</span><strong id="total-waiting">—</strong></div></div>
    <div class="notification-bar" id="notification-bar" hidden><p><span id="pending-emails">0</span> email notifications need sending. All responses are saved.</p><button class="text-link" id="retry-emails">Retry up to 10 emails ↗︎</button></div>
    <section class="admin-card" aria-labelledby="new-invitation-title"><h2 id="new-invitation-title">Make room for someone special.</h2><p>Add each guest’s name, then create their private link and QR. Each named guest can share up to 10 photos when uploads open.</p><form id="create-invitation" class="invite-create named-invite-create"><div><label for="max-guests">People on this invitation</label><select id="max-guests" name="maxGuests"><option value="2">2 people</option><option value="1">1 person</option></select></div><div><label for="first-guest">First guest’s name</label><input id="first-guest" name="firstGuest" maxlength="120" required placeholder="Alex Santos" /></div><div id="second-guest-field"><label for="second-guest">Second guest’s name</label><input id="second-guest" name="secondGuest" maxlength="120" required placeholder="Sam Santos" /></div><div><label for="household">Invitation label <span>(optional)</span></label><input id="household" name="household" maxlength="120" placeholder="e.g. Alex & Sam" /></div><button class="button" type="submit" id="create-invitation-submit">Create invitation +</button><button class="text-link" type="button" id="cancel-edit" hidden>Cancel editing</button></form><div id="created-invitation" hidden><p id="created-code-row" class="created-code" hidden>Invitation code <strong id="created-code"></strong></p><label for="created-link">Your private invitation link</label><input id="created-link" readonly /><p class="admin-lead">Share this link, its QR, or the 6-character code privately. Guests without the link can type the code on the homepage RSVP section.</p></div></section>
    <div class="admin-toolbar"><h2 id="guest-list-title">Your guest list</h2><label class="sr-only" for="search">Search guests</label><input type="search" id="search" placeholder="Search names or email…" /><div class="admin-actions"><button class="text-link" id="refresh">Refresh</button><button class="text-link" id="export">Export CSV ↓</button></div></div>
    <div class="guest-filters"><div><label for="filter-response">Response</label><select id="filter-response"><option value="">All responses</option><option value="attending">Attending</option><option value="declined">Declined</option><option value="awaiting">Awaiting reply</option></select></div><div><label for="filter-people">People</label><select id="filter-people"><option value="">Any number</option><option value="0">None yet / 0</option><option value="1">1 person</option><option value="2">2 people</option></select></div><button class="text-link" type="button" id="clear-filters" hidden>Clear filters</button><p id="guest-list-count" class="guest-count"></p></div>
    <div class="bulk-bar" id="bulk-bar" hidden role="region" aria-label="Selected invitations"><p><strong id="bulk-count">0</strong> <span id="bulk-label">invitations selected</span></p><div class="bulk-actions"><button type="button" class="text-link" id="bulk-select-matching">Select all matching</button><button type="button" class="text-link" id="bulk-clear">Clear selection</button><button type="button" class="button bulk-remove" id="bulk-remove">Remove selected</button></div></div>
    <div class="table-wrap guest-table"><table><colgroup><col class="col-select" /><col class="col-invite" /><col class="col-response" /><col class="col-people" /><col class="col-message" /><col class="col-actions" /></colgroup><thead><tr><th class="select-cell"><input type="checkbox" id="select-page" aria-label="Select all invitations on this page" /></th><th>Invitation</th><th><button type="button" class="sort-header" data-sort="response" aria-label="Sort by response">Response <span aria-hidden="true"></span></button></th><th><button type="button" class="sort-header" data-sort="people" aria-label="Sort by people">People <span aria-hidden="true"></span></button></th><th>Message & contact</th><th>Actions</th></tr></thead><tbody id="guest-list"></tbody></table></div><p id="guest-list-empty" class="empty-state" hidden>No invitations yet. Create your first one above.</p>
    <div class="gallery-pagination" id="guest-pagination" hidden><button class="text-link" id="guest-prev" disabled>← Previous</button><span id="guest-page"></span><button class="text-link" id="guest-next" disabled>Next →</button></div>
  </main>
  <script src="../scripts/admin.ts"></script>
</Layout>
