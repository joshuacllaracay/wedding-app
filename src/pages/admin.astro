---
import Layout from '../layouts/Layout.astro';
import { requireAdmin } from '../lib/server';
export const prerender = false;
try { await requireAdmin(Astro); } catch { return Astro.redirect('/login'); }
---
<Layout title="Our wedding portal · Chyka & Emmanuel" privatePage>
  <main class="admin-shell">
    <header class="admin-header"><div><span class="eyebrow">CHYKA & EMMANUEL / YOUR CELEBRATION</span><h1>A seat for everyone you love.</h1></div><div class="admin-actions"><a class="text-link" href="/" target="_blank" rel="noopener">View invitation ↗</a><button class="text-link" id="logout">Sign out</button></div></header>
    <p class="admin-lead">One invitation, up to two people. Responses update the existing invitation so your headcount stays accurate.</p>
    <nav class="portal-nav" aria-label="Wedding portal"><a href="#new-invitation-title">Invitations</a><a href="#guest-list-title">Guest list</a><a href="#memory-settings-title">Photo sharing</a><a href="#gallery-title">Our memories</a></nav>
    <div id="dashboard-status" role="status" aria-live="polite" class="admin-status"></div>
    <div class="stats"><div class="stat"><span>Confirmed people</span><strong id="total-guests">—</strong></div><div class="stat"><span>Accepting invitations</span><strong id="total-accepting">—</strong></div><div class="stat"><span>Declined invitations</span><strong id="total-declined">—</strong></div><div class="stat"><span>Awaiting a response</span><strong id="total-waiting">—</strong></div></div>
    <div class="notification-bar" id="notification-bar" hidden><p><span id="pending-emails">0</span> email notifications need sending. All responses are saved.</p><button class="text-link" id="retry-emails">Retry up to 10 emails ↗</button></div>
    <section class="admin-card" aria-labelledby="new-invitation-title"><h2 id="new-invitation-title">Make room for someone special.</h2><p>Add each guest’s name, then create their private link and QR. Each named guest can share up to 10 photos when uploads open.</p><form id="create-invitation" class="invite-create named-invite-create"><div><label for="max-guests">People on this invitation</label><select id="max-guests" name="maxGuests"><option value="2">2 people</option><option value="1">1 person</option></select></div><div><label for="first-guest">First guest’s name</label><input id="first-guest" name="firstGuest" maxlength="120" required placeholder="Alex Santos" /></div><div id="second-guest-field"><label for="second-guest">Second guest’s name</label><input id="second-guest" name="secondGuest" maxlength="120" required placeholder="Sam Santos" /></div><div><label for="household">Invitation label <span>(optional)</span></label><input id="household" name="household" maxlength="120" placeholder="e.g. Alex & Sam" /></div><button class="button" type="submit" id="create-invitation-submit">Create invitation +</button><button class="text-link" type="button" id="cancel-edit" hidden>Cancel editing</button></form><div id="created-invitation" hidden><label for="created-link">Your private invitation link</label><input id="created-link" readonly /><p class="admin-lead">Share this link or its QR privately. It identifies the invitation for RSVPs and photo uploads.</p></div></section>
    <div class="admin-toolbar"><h2 id="guest-list-title">Your guest list</h2><label class="sr-only" for="search">Search guests</label><input type="search" id="search" placeholder="Search names or email…" /><div class="admin-actions"><button class="text-link" id="refresh">Refresh</button><button class="text-link" id="export">Export CSV ↓</button></div></div>
    <div class="table-wrap"><table><thead><tr><th>Invitation</th><th>Response</th><th>People</th><th>Message & contact</th><th>Actions</th></tr></thead><tbody id="guest-list"></tbody></table></div><p id="guest-list-empty" class="empty-state" hidden>No invitations yet. Create your first one above.</p>
    <section class="admin-card memory-settings" aria-labelledby="memory-settings-title"><div><span class="eyebrow">A LITTLE SOMETHING FOR THE BIG DAY</span><h2 id="memory-settings-title">Open the doors to memories.</h2><p>The “Share your memories” button appears on private invitations while uploads are open. Schedule it once, or change it here at any time.</p></div><form id="memory-settings-form"><label for="memory-mode">Photo sharing</label><select id="memory-mode"><option value="closed">Closed — hide the sharing button</option><option value="scheduled">Scheduled — use the dates below</option><option value="open">Open now — until I close it</option></select><div id="memory-schedule" class="form-row" hidden><div><label for="memory-opens">Opens (Singapore time, UTC+08)</label><input type="datetime-local" id="memory-opens" /></div><div><label for="memory-closes">Closes (Singapore time, UTC+08)</label><input type="datetime-local" id="memory-closes" /></div></div><button type="submit" class="button">Save photo-sharing settings <span aria-hidden="true">→</span></button></form></section>
    <div id="memories-admin-status" role="status" aria-live="polite" class="admin-status"></div>
    <div id="cleanup-panel" class="notification-bar" hidden><p><span id="expired-photo-count">0</span> expired or removed uploads can be cleared to return guest photo slots.</p><button class="text-link" id="cleanup-photos">Release expired slots ↗</button></div>
    <section class="memory-gallery" aria-labelledby="gallery-title"><div class="admin-toolbar"><div><span class="eyebrow">OUR DAY, THROUGH THEIR EYES</span><h2 id="gallery-title">A collection of little forevers.</h2><p id="gallery-total" class="admin-lead"></p></div><button id="gallery-refresh" class="text-link">Refresh gallery</button></div><div class="gallery-controls"><div><label for="gallery-guest">Photos from</label><select id="gallery-guest"><option value="">Everyone</option></select></div><button id="download-selected" class="button" disabled>Download selected ZIP (0/10)</button></div><p class="admin-lead">Select up to 10 originals per ZIP to keep downloads manageable. Click a photo to view it larger.</p><div id="gallery-grid" class="gallery-grid"></div><p id="gallery-empty" class="empty-state" hidden>Your memories will appear here when guests share their photos.</p><div class="gallery-pagination"><button class="text-link" id="gallery-prev" disabled>← Previous</button><span id="gallery-page"></span><button class="text-link" id="gallery-next" disabled>Next →</button></div></section>
    <dialog id="photo-viewer" class="photo-viewer"><button type="button" id="close-photo-viewer" class="text-link">Close ×</button><img id="photo-viewer-image" alt="" /><p id="photo-viewer-caption"></p><button type="button" id="photo-viewer-download" class="button">Download original ↓</button><button type="button" id="photo-viewer-remove" class="text-link danger-link">Remove photo</button></dialog>
  </main>
  <script src="../scripts/admin.ts"></script>
</Layout>
