---
import Layout from '../layouts/Layout.astro';
import VenueSketch from '../components/VenueSketch.astro';
import ProgramIcon from '../components/ProgramIcon.astro';
import Orchid from '../components/Orchid.astro';
import Lanterns from '../components/Lanterns.astro';
import Drape from '../components/Drape.astro';
import GiftQrTeaser from '../components/GiftQrTeaser.astro';
import { wedding } from '../config/wedding';
const archDate = new Date(wedding.ceremonyStartsAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'Asia/Manila' });
---
<Layout title={`${wedding.bride} & ${wedding.groom} · A wedding invitation`}>
  <a class="skip-link" href="#invitation">Skip to invitation</a>
  <div class="ribbon-screen" id="envelope-screen">
    <div class="ribbon-backdrop" aria-hidden="true"></div>
    <button class="ribbon-stage" id="open-envelope" aria-label="Open your wedding invitation">
      <span class="ribbon-door left" aria-hidden="true"><span class="door-face front"></span><span class="door-face back"></span></span>
      <!-- The ribbon is tied to the right flap, so it swings open with it like a gatefold card. -->
      <span class="ribbon-door right" aria-hidden="true">
        <span class="door-face front"></span><span class="door-face back"></span>
        <span class="ribbon-bow"><img class="bow-art" src="/ribbon/bow.webp" alt="" decoding="async" /></span>
      </span>
      <span class="ribbon-hint" aria-hidden="true"><span class="ribbon-hint-dot"></span>Tap to open your invitation</span>
    </button>
  </div>

  <main id="invitation" tabindex="-1">
    {wedding.sampleDetails && <div class="sample-banner">DESIGN PREVIEW · Date, venue, and event details are samples</div>}
    <section class="film-hero" aria-labelledby="film-names">
      {wedding.teaserVideoUrl && <video class="film-video" id="film-video" src={`${wedding.teaserVideoUrl}#t=${wedding.heroVideoLoop.start}`} data-loop-start={wedding.heroVideoLoop.start} data-loop-end={wedding.heroVideoLoop.end} muted playsinline preload="auto" aria-hidden="true"></video>}
      <div class="film-shade" aria-hidden="true"></div>
      <span class="film-monogram hero-reveal" style="--d:.2s" aria-hidden="true"><span>{wedding.heroNames[0].charAt(0)}</span><i>&amp;</i><span>{wedding.heroNames[1].charAt(0)}</span></span>
      <div class="film-text">
        <h1 id="film-names" class="film-names hero-reveal" style="--d:.5s">{wedding.heroNames[0]} <i>&amp;</i> {wedding.heroNames[1]}</h1>
        <p class="film-sub hero-reveal" style="--d:.9s">are getting married</p>
      </div>
    </section>

    <section class="hero hero-arch" aria-labelledby="couple-names">
      <div class="arch arch-copy left hero-reveal" style="--d:.5s" data-land={JSON.stringify([[19, 13], [9, 16.5], [93.4, 16.7], [75, 14.5], [90, 62], [78.5, 60], [14, 60], [7.5, 63], [31, 89.5], [78.5, 69.5]])} aria-hidden="true">
        <img class="arch-art" src="/hero/arch-left.webp" width="303" height="660" alt="" decoding="async" />
        <div class="arch-figure-wrap">
          <svg class="arch-figure groom" viewBox="0 0 120 300" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="fg-barong" x1="0" x2="1"><stop offset="0" stop-color="#f6eddf"/><stop offset=".6" stop-color="#ebdec8"/><stop offset="1" stop-color="#d8c5a7"/></linearGradient>
              <linearGradient id="fg-pants" x1="0" x2="1"><stop offset="0" stop-color="#5c4235"/><stop offset="1" stop-color="#3d2a21"/></linearGradient>
              <linearGradient id="fg-skin" x1="0" x2="1"><stop offset="0" stop-color="#f1d5b7"/><stop offset="1" stop-color="#d8ae88"/></linearGradient>
            </defs>
            <path d="M41 146 37 281h14l6-112 5 112h14l-2-135z" fill="url(#fg-pants)"/>
            <path d="M34 279h18l1 7H30c0-4 1-6 4-7zm28 0h16c4 1 7 3 7 7H62z" fill="#1d1512"/>
            <path d="M53 44h10v14H53z" fill="url(#fg-skin)"/>
            <path d="M37 59c6-7 34-7 40 0l3 91c-14 6-31 6-44 0z" fill="url(#fg-barong)"/>
            <path d="M52 64v82M62 64v82" stroke="#fffaf1" stroke-width="2.6" stroke-dasharray="1.6 1.8" opacity=".9"/>
            <path d="M47 68c3 9 3 22 2 32m18-32c-3 9-3 22-2 32" stroke="#d6c3a5" stroke-width=".8" fill="none"/>
            <path d="M51 55h12l-1 7-5 4-5-4z" fill="#f3e9d8" stroke="#d6c3a5" stroke-width=".7"/>
            <g fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M42 64 44 94 64 50M73 64l13 24-4-38" stroke="#c9b493" stroke-width="11"/>
              <path d="M42 64 44 94 64 50M73 64l13 24-4-38" stroke="#efe4d2" stroke-width="9"/>
            </g>
            <ellipse cx="58" cy="35" rx="11" ry="13.5" fill="url(#fg-skin)"/>
            <path d="M47 37c-3-15 7-22 17-20 7 1 10 7 9 13-6-5-15-5-21 1l-1 9z" fill="#33241c"/>
            <rect x="63" y="28" width="25" height="16" rx="3" fill="#2a201b"/>
            <rect x="69" y="24" width="8" height="5" rx="1" fill="#2a201b"/>
            <circle cx="89" cy="36" r="6.5" fill="#3b2f29" stroke="#17110e" stroke-width="1.5"/>
            <circle cx="89" cy="36" r="2.6" fill="#7d6a5d"/>
            <ellipse cx="65" cy="45" rx="4.6" ry="4" fill="url(#fg-skin)"/><ellipse cx="82" cy="46" rx="4.6" ry="4" fill="url(#fg-skin)"/>
          </svg>
        </div>
      </div>
      <div class="arch hero-reveal" style="--d:.2s" id="hero-arch" data-land={JSON.stringify([[81, 13], [91, 16.5], [6.6, 16.7], [25, 14.5], [10, 62], [21.5, 60], [86, 60], [92.5, 63], [69, 89.5], [21.5, 69.5]])}>
        <img class="arch-art" src="/hero/arch.webp" width="303" height="660" alt="" decoding="async" fetchpriority="high" />
        <div class="arch-text">
          <h2 id="couple-names" class="arch-names"><span class="hero-name">{wedding.bride}</span><span class="ampersand" id="hero-ampersand">&amp;</span><span class="hero-name">{wedding.groom}</span></h2>
          <p class="arch-date">{archDate}</p>
          <span class="arch-rule" aria-hidden="true"><i></i></span>
          <p class="arch-venue">{wedding.venue}</p>
        </div>
        <!-- Phones show only this arch, so the couple stands here on small screens. -->
        <div class="arch-figure-wrap phone-couple" aria-hidden="true">
          <svg class="arch-figure bride phone" viewBox="0 0 120 300" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="fbm-gown" x1="0" x2="1"><stop offset="0" stop-color="#fffaf2"/><stop offset=".55" stop-color="#f3e8d6"/><stop offset="1" stop-color="#dfcdb1"/></linearGradient>
              <linearGradient id="fbm-skin" x1="0" x2="1"><stop offset="0" stop-color="#f2d7ba"/><stop offset="1" stop-color="#d9b08b"/></linearGradient>
            </defs>
            <path d="M58 44c14 6 20 40 22 84 2 60 8 108 30 158-14 2-24 1-30-2-6-60-14-120-22-170z" fill="#fffdf8" opacity=".35"/>
            <path d="M38 106c8 8 22 8 29 2 10 44 26 110 47 176-30 9-66 9-96 0 5-60 12-120 20-178z" fill="url(#fbm-gown)"/>
            <path d="M48 116c-4 50-10 110-16 168M57 118c2 50 4 110 10 168M64 114c10 50 20 110 32 172" stroke="#d5c1a2" stroke-width="1" fill="none" opacity=".75"/>
            <path d="M20 280c30 9 62 9 94 3" stroke="#d5c1a2" stroke-width="1" fill="none" opacity=".6"/>
            <path d="M43 52h8l1 15H42z" fill="url(#fbm-skin)"/>
            <path d="M31 67c6-6 25-6 31 0v6H32z" fill="url(#fbm-skin)"/>
            <path d="M60 68c8 5 15 2 18-16" stroke="url(#fbm-skin)" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <ellipse cx="78" cy="50" rx="3.2" ry="4.4" fill="url(#fbm-skin)"/>
            <path d="M33 72c4-4 10-4 14 0 4-4 10-4 15 0l5 36c-8 7-22 7-30 0z" fill="url(#fbm-gown)"/>
            <path d="M33 72c4-4 10-4 14 0 4-4 10-4 15 0" stroke="#d5c1a2" stroke-width=".8" fill="none"/>
            <path d="M38 104c8 4 20 4 29 0" stroke="#e8d9c1" stroke-width="2" fill="none"/>
            <path d="M35 72c-6 12-6 24 0 34 3 5 8 8 12 9" stroke="url(#fbm-skin)" stroke-width="5.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <g transform="translate(46 115)"><path d="M-2 8 -4 26M2 8l3 18" stroke="#8a7357" stroke-width="1.1"/><circle r="6" fill="#f7efe2"/><circle cx="-5" cy="3" r="4.5" fill="#efdcc4"/><circle cx="5" cy="3" r="4.5" fill="#f3e3cf"/><circle cy="-4" r="4" fill="#fffaf2"/></g>
            <g transform="rotate(-10 46 40)">
              <ellipse cx="46" cy="40" rx="10" ry="13" fill="url(#fbm-skin)"/>
              <path d="M35 41c-2-15 9-22 18-19 7 2 9 9 7 16-6-6-15-6-23 3z" fill="#3a271f"/>
              <circle cx="57" cy="44" r="6.5" fill="#3a271f"/>
              <path d="M57 39c4 2 6 5 5 9" stroke="#f6efe3" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            </g>
          </svg>
          <svg class="arch-figure groom phone" viewBox="0 0 120 300" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="fgm-barong" x1="0" x2="1"><stop offset="0" stop-color="#f6eddf"/><stop offset=".6" stop-color="#ebdec8"/><stop offset="1" stop-color="#d8c5a7"/></linearGradient>
              <linearGradient id="fgm-pants" x1="0" x2="1"><stop offset="0" stop-color="#5c4235"/><stop offset="1" stop-color="#3d2a21"/></linearGradient>
              <linearGradient id="fgm-skin" x1="0" x2="1"><stop offset="0" stop-color="#f1d5b7"/><stop offset="1" stop-color="#d8ae88"/></linearGradient>
            </defs>
            <path d="M41 146 37 281h14l6-112 5 112h14l-2-135z" fill="url(#fgm-pants)"/>
            <path d="M34 279h18l1 7H30c0-4 1-6 4-7zm28 0h16c4 1 7 3 7 7H62z" fill="#1d1512"/>
            <path d="M53 44h10v14H53z" fill="url(#fgm-skin)"/>
            <path d="M37 59c6-7 34-7 40 0l3 91c-14 6-31 6-44 0z" fill="url(#fgm-barong)"/>
            <path d="M52 64v82M62 64v82" stroke="#fffaf1" stroke-width="2.6" stroke-dasharray="1.6 1.8" opacity=".9"/>
            <path d="M47 68c3 9 3 22 2 32m18-32c-3 9-3 22-2 32" stroke="#d6c3a5" stroke-width=".8" fill="none"/>
            <path d="M51 55h12l-1 7-5 4-5-4z" fill="#f3e9d8" stroke="#d6c3a5" stroke-width=".7"/>
            <g fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M42 64 44 94 64 50M73 64l13 24-4-38" stroke="#c9b493" stroke-width="11"/>
              <path d="M42 64 44 94 64 50M73 64l13 24-4-38" stroke="#efe4d2" stroke-width="9"/>
            </g>
            <ellipse cx="58" cy="35" rx="11" ry="13.5" fill="url(#fgm-skin)"/>
            <path d="M47 37c-3-15 7-22 17-20 7 1 10 7 9 13-6-5-15-5-21 1l-1 9z" fill="#33241c"/>
            <rect x="63" y="28" width="25" height="16" rx="3" fill="#2a201b"/>
            <rect x="69" y="24" width="8" height="5" rx="1" fill="#2a201b"/>
            <circle cx="89" cy="36" r="6.5" fill="#3b2f29" stroke="#17110e" stroke-width="1.5"/>
            <circle cx="89" cy="36" r="2.6" fill="#7d6a5d"/>
            <ellipse cx="65" cy="45" rx="4.6" ry="4" fill="url(#fgm-skin)"/><ellipse cx="82" cy="46" rx="4.6" ry="4" fill="url(#fgm-skin)"/>
          </svg>
        </div>
      </div>
      <div class="arch arch-copy right hero-reveal" style="--d:.5s" data-land={JSON.stringify([[81, 13], [91, 16.5], [6.6, 16.7], [25, 14.5], [10, 62], [21.5, 60], [86, 60], [92.5, 63], [69, 89.5], [21.5, 69.5]])} aria-hidden="true">
        <img class="arch-art" src="/hero/arch-right.webp" width="303" height="660" alt="" decoding="async" />
        <div class="arch-figure-wrap">
          <svg class="arch-figure bride" viewBox="0 0 120 300" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="fb-gown" x1="0" x2="1"><stop offset="0" stop-color="#fffaf2"/><stop offset=".55" stop-color="#f3e8d6"/><stop offset="1" stop-color="#dfcdb1"/></linearGradient>
              <linearGradient id="fb-skin" x1="0" x2="1"><stop offset="0" stop-color="#f2d7ba"/><stop offset="1" stop-color="#d9b08b"/></linearGradient>
            </defs>
            <path d="M58 44c14 6 20 40 22 84 2 60 8 108 30 158-14 2-24 1-30-2-6-60-14-120-22-170z" fill="#fffdf8" opacity=".35"/>
            <path d="M38 106c8 8 22 8 29 2 10 44 26 110 47 176-30 9-66 9-96 0 5-60 12-120 20-178z" fill="url(#fb-gown)"/>
            <path d="M48 116c-4 50-10 110-16 168M57 118c2 50 4 110 10 168M64 114c10 50 20 110 32 172" stroke="#d5c1a2" stroke-width="1" fill="none" opacity=".75"/>
            <path d="M20 280c30 9 62 9 94 3" stroke="#d5c1a2" stroke-width="1" fill="none" opacity=".6"/>
            <path d="M43 52h8l1 15H42z" fill="url(#fb-skin)"/>
            <path d="M31 67c6-6 25-6 31 0v6H32z" fill="url(#fb-skin)"/>
            <path d="M35 68c-8 5-15 2-18-16" stroke="url(#fb-skin)" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <ellipse cx="17" cy="50" rx="3.2" ry="4.4" fill="url(#fb-skin)"/>
            <path d="M33 72c4-4 10-4 14 0 4-4 10-4 15 0l5 36c-8 7-22 7-30 0z" fill="url(#fb-gown)"/>
            <path d="M33 72c4-4 10-4 14 0 4-4 10-4 15 0" stroke="#d5c1a2" stroke-width=".8" fill="none"/>
            <path d="M38 104c8 4 20 4 29 0" stroke="#e8d9c1" stroke-width="2" fill="none"/>
            <path d="M61 72c6 12 6 24 0 34-3 5-8 8-12 9" stroke="url(#fb-skin)" stroke-width="5.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <g transform="translate(46 115)"><path d="M-2 8 -4 26M2 8l3 18" stroke="#8a7357" stroke-width="1.1"/><circle r="6" fill="#f7efe2"/><circle cx="-5" cy="3" r="4.5" fill="#efdcc4"/><circle cx="5" cy="3" r="4.5" fill="#f3e3cf"/><circle cy="-4" r="4" fill="#fffaf2"/></g>
            <g transform="rotate(-10 46 40)">
              <ellipse cx="46" cy="40" rx="10" ry="13" fill="url(#fb-skin)"/>
              <path d="M35 41c-2-15 9-22 18-19 7 2 9 9 7 16-6-6-15-6-23 3z" fill="#3a271f"/>
              <circle cx="57" cy="44" r="6.5" fill="#3a271f"/>
              <path d="M57 39c4 2 6 5 5 9" stroke="#f6efe3" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <section class="film-section" aria-labelledby="film-title">
      <svg class="film-reel" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <defs><radialGradient id="reel-metal" cx="35%" cy="30%" r="80%"><stop offset="0" stop-color="#f0d2a8"/><stop offset=".5" stop-color="#b8875c"/><stop offset="1" stop-color="#6b4a33"/></radialGradient></defs>
        <circle cx="100" cy="100" r="96" fill="url(#reel-metal)"/>
        <circle cx="100" cy="100" r="88" fill="none" stroke="#5a3d2b" stroke-width="2" opacity=".5"/>
        <g fill="#3a271d"><circle cx="100" cy="44" r="23"/><circle cx="100" cy="156" r="23"/><circle cx="44" cy="100" r="23"/><circle cx="156" cy="100" r="23"/><circle cx="60" cy="60" r="15"/><circle cx="140" cy="140" r="15"/><circle cx="140" cy="60" r="15"/><circle cx="60" cy="140" r="15"/></g>
        <circle cx="100" cy="100" r="16" fill="#e6c496" stroke="#5a3d2b" stroke-width="3"/><circle cx="100" cy="100" r="5" fill="#3a271d"/>
      </svg>
      <p class="film-invite">You are cordially invited<br />to the wedding of</p>
      <h2 id="film-title" class="film-couple">{wedding.bride} <i>&amp;</i> {wedding.heroNames[0]}</h2>
      <p class="film-date"><i></i>{wedding.storyDate}<i></i></p>
      <!-- The strip rolls on its own; drag to move it, tap a frame to open it (film-strip.ts). -->
      <div class="film-strip" id="film-strip" data-photos={JSON.stringify(Array.from({ length: wedding.storyPhotoCount }, (_, i) => `/story/photo-${i + 1}.jpg`))}>
        <div class="film-track">
          {[0, 1].map(copy => Array.from({ length: wedding.storyPhotoCount }, (_, i) => (
            <button type="button" class="film-frame" data-index={i} aria-label={`Open photo ${i + 1} of ${wedding.storyPhotoCount}`} tabindex={copy ? -1 : 0} aria-hidden={copy ? 'true' : undefined}>
              <img src={`/story/thumb-${i + 1}.jpg`} width="520" height="347" alt="" loading="lazy" decoding="async" draggable="false" />
            </button>
          )))}
        </div>
      </div>
      <p class="film-hint">Swipe the film, or tap a frame to see it big</p>
      <div class="film-countdown">
        <p class="countdown-title" id="countdown-title">The day we say <em>&ldquo;I do&rdquo;</em></p>
        <div class="countdown" id="countdown" data-target={wedding.ceremonyStartsAt} role="timer" aria-label={`Countdown to ${wedding.date}`}>
        <div class="countdown-unit"><strong data-unit="days">—</strong><span>Days</span></div>
        <div class="countdown-unit"><strong data-unit="hours">—</strong><span>Hours</span></div>
        <div class="countdown-unit"><strong data-unit="minutes">—</strong><span>Minutes</span></div>
        <div class="countdown-unit"><strong data-unit="seconds">—</strong><span>Seconds</span></div>
        </div>
        <p class="countdown-done" id="countdown-done" hidden>Today, we say <em>I do.</em></p>
      </div>
      <dialog id="film-viewer" class="film-viewer" aria-label="Photo viewer">
        <div class="film-viewer-frame"><img class="film-viewer-img" src="" alt="Prenup photo of Chyka and Emmanuel" /></div>
        <button type="button" class="film-close" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <button type="button" class="film-prev" aria-label="Previous photo"><span aria-hidden="true">&lsaquo;</span></button>
        <button type="button" class="film-next" aria-label="Next photo"><span aria-hidden="true">&rsaquo;</span></button>
        <p class="film-viewer-count" aria-live="polite"></p>
      </dialog>
    </section>

    <section class="welcome section-pad" aria-labelledby="welcome-title">
      <Orchid id="orchid-welcome-a" class="welcome-orchid top" />
      <Orchid id="orchid-welcome-b" class="welcome-orchid bottom" />
      <div class="welcome-inner">
        <p class="welcome-faith">Rooted in faith &middot; united in love &middot; blessed by God</p>
        <h2 id="welcome-title" class="welcome-title">Welcome</h2>
        <p>With grateful hearts and by God&rsquo;s grace, we invite you to celebrate one of the most meaningful days of our lives. Your love, prayers and presence have been part of our journey, and it would mean the world to us to have you with us as we say <strong>&ldquo;I do.&rdquo;</strong></p>
        <p>Here you&rsquo;ll find everything you need to know about our day: the venue, the program, the dress code and your RSVP. We can&rsquo;t wait to celebrate with you!</p>
        <p class="welcome-sign">With all our love,</p>
        <p class="welcome-names">{wedding.heroNames[0]} <i>&amp;</i> {wedding.heroNames[1]}</p>
      </div>
    </section>


    <section id="venue" class="venue section-pad" aria-labelledby="venue-title">
      <span class="eyebrow">THE VENUE</span>
      <h2 id="venue-title">{wedding.venue.split(',')[0]}<em>{wedding.venue.includes(',') ? `, ${wedding.venue.split(',').slice(1).join(',').trim()}` : ''}</em></h2>
      <p class="venue-copy">A Spanish-inspired hacienda in the heart of Cebu City,<br class="desktop-break" /> set among gardens, where we will say our vows.</p>
      <div class="venue-art" id="venue-art"><VenueSketch label={`Pencil-style sketch of ${wedding.venue}`} /></div>
      <button type="button" class="venue-replay" id="venue-replay" disabled><span aria-hidden="true">↻</span> Replay sketch</button>
      <p class="venue-address">{wedding.address}</p>
      <div class="venue-links">
        {wedding.venueUrl && <a class="text-link" href={wedding.venueUrl} target="_blank" rel="noopener noreferrer">Visit {wedding.venue.split(',')[0]} <span aria-hidden="true">↗︎</span></a>}
        {wedding.mapsUrl && <a class="text-link" href={wedding.mapsUrl} target="_blank" rel="noopener noreferrer">View directions <span aria-hidden="true">↗︎</span></a>}
      </div>
    </section>

    <section id="program" class="program program-garden" aria-labelledby="program-title">
      <Drape id="drape-program" class="program-drape" />
      <Lanterns id="lanterns-left" side="left" class="program-lanterns left" />
      <Lanterns id="lanterns-right" side="right" class="program-lanterns right" />
      <div class="program-arch">
      <span class="eyebrow">THE PROGRAM</span>
      <h2 id="program-title" class="script-title">Order of the Day</h2>
      <p class="program-date">{wedding.date}</p>
      <ol class="program-list">
        {wedding.program.map(item => (
          <li class="program-item">
            <span class="program-icon-wrap"><ProgramIcon name={item.icon} /></span>
            <span class="program-dot" aria-hidden="true"></span>
            <p class="program-time"><time>{item.time}</time><span>{item.period}</span></p>
            <p class="program-title">{item.title}</p>
          </li>
        ))}
      </ol>
      <Orchid id="orchid-program" class="program-orchid" />
      </div>
    </section>

    <section id="attire" class="attire dress-code section-pad" aria-labelledby="attire-title">
      <div class="dress-column">
      <Orchid id="orchid-dress-a" class="dress-orchid top" />
      <div class="dress-paper"><span class="eyebrow">01 / DRESSED IN LOVE</span><h2 id="attire-title" class="script-title">Dress Code</h2>
      <ul class="dress-palette" aria-label="Our colour palette">{wedding.guestPalette.map(c => <li style={`--swatch:${c.hex}`}><span aria-hidden="true"></span><small>{c.name}</small></li>)}</ul>
      </div>
      <div class="dress-card"><Orchid id="orchid-dress-b" class="dress-orchid card" />
        <p class="dress-intro">{wedding.dressCodeIntro}</p>
        <div class="dress-rules"><div><h3>For gentlemen</h3><p>{wedding.dressGentlemen}</p></div><div><h3>For ladies</h3><p>{wedding.dressLadies}</p></div></div>
      </div>
      <div class="dress-photos">
        {wedding.guestAttire.map((item, i) => (
          <figure class={`dress-photo ${i % 2 ? 'tilt-right' : 'tilt-left'}`}>
            <span class="dress-tape" aria-hidden="true"></span>
            <img src={item.image} width={item.width} height={item.height} alt={item.alt} loading="lazy" decoding="async" />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
        <Orchid id="orchid-dress-c" class="dress-orchid photos" />
      </div>
      </div>
    </section>

    <section id="gifts" class="gifts section-pad" aria-labelledby="gifts-title">
      <svg class="satin-drape tl" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="gift-satin-tl-a" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4e3628"/><stop offset=".35" stop-color="#9c7154"/><stop offset=".5" stop-color="#d9b48c"/><stop offset=".65" stop-color="#8a5e3f"/><stop offset="1" stop-color="#3d2a1f"/></linearGradient>
          <linearGradient id="gift-satin-tl-b" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#5a3d2b"/><stop offset=".45" stop-color="#b58a63"/><stop offset=".6" stop-color="#e6c9a3"/><stop offset="1" stop-color="#6b4a33"/></linearGradient>
        </defs>
        <path d="M0 0h400C330 40 300 70 250 120 190 180 120 210 0 230z" fill="url(#gift-satin-tl-a)"/>
        <path d="M0 0h260C210 60 170 110 110 150 70 175 35 190 0 196z" fill="url(#gift-satin-tl-b)" opacity=".85"/>
        <path d="M0 120C60 110 120 80 170 40 190 25 205 12 215 0" fill="none" stroke="#f3dfc2" stroke-width="2" opacity=".45"/>
        <path d="M0 200C90 180 170 140 240 80" fill="none" stroke="#2e1f17" stroke-width="3" opacity=".25"/>
      </svg>
      <svg class="satin-drape br" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="gift-satin-br-a" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4e3628"/><stop offset=".35" stop-color="#9c7154"/><stop offset=".5" stop-color="#d9b48c"/><stop offset=".65" stop-color="#8a5e3f"/><stop offset="1" stop-color="#3d2a1f"/></linearGradient>
          <linearGradient id="gift-satin-br-b" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#5a3d2b"/><stop offset=".45" stop-color="#b58a63"/><stop offset=".6" stop-color="#e6c9a3"/><stop offset="1" stop-color="#6b4a33"/></linearGradient>
        </defs>
        <path d="M0 0h400C330 40 300 70 250 120 190 180 120 210 0 230z" fill="url(#gift-satin-br-a)"/>
        <path d="M0 0h260C210 60 170 110 110 150 70 175 35 190 0 196z" fill="url(#gift-satin-br-b)" opacity=".85"/>
        <path d="M0 120C60 110 120 80 170 40 190 25 205 12 215 0" fill="none" stroke="#f3dfc2" stroke-width="2" opacity=".45"/>
        <path d="M0 200C90 180 170 140 240 80" fill="none" stroke="#2e1f17" stroke-width="3" opacity=".25"/>
      </svg>
      <div class="gift-card">
        <!-- White lilies (Pixabay Content License), centres toned to champagne. -->
        <img class="gift-lilies top" src="/decor/lilies-garland.webp" width="1000" height="441" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <img class="gift-lilies bottom" src="/decor/lilies-cluster.webp" width="560" height="588" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <p class="gift-mono" aria-hidden="true"><i></i><span>{wedding.bride.charAt(0)}<b>&amp;</b>{wedding.groom.charAt(0)}</span><i></i></p>
        <h2 id="gifts-title" class="gift-title"><span>A Foundation for</span> <span class="gift-title-big">Forever</span></h2>
        <span class="gift-swash" aria-hidden="true"></span>
        <p class="gift-copy">As two hearts become one, we look forward to creating a lifetime of memories and dreams.</p>
        <span class="gift-sprig" aria-hidden="true"><i></i><svg viewBox="0 0 60 24" aria-hidden="true" focusable="false"><path d="M8 20C20 16 32 10 52 4" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M20 15c-2-5 1-9 6-10-1 5-3 8-6 10zM30 11c-1-5 3-8 8-8-2 5-4 7-8 8zM40 7c0-4 3-6 7-6-2 4-4 5-7 6zM24 15c4 1 7 4 8 8-4-1-7-4-8-8zM34 10c4 0 7 3 8 6-4 0-7-2-8-6z" fill="currentColor"/></svg><i></i></span>
        <p class="gift-copy">If you wish to share a gift, a contribution toward the life we&rsquo;re building together would be a beautiful blessing.</p>
        <!-- Tap to reveal the real QR codes (gifts.ts). -->
        <button type="button" class="gift-reveal" id="gift-reveal" aria-haspopup="dialog" aria-controls="gift-dialog">
          <GiftQrTeaser />
          <span class="gift-reveal-rule" aria-hidden="true"></span>
          <span class="gift-reveal-cta">
            <span class="gift-reveal-top"><svg class="gift-phone" viewBox="0 0 48 56" aria-hidden="true" focusable="false"><rect x="4" y="2" width="26" height="46" rx="5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M13 7h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M26 44V28c0-2 3-2 3 0v9-12c0-2 3-2 3 0v12-10c0-2 3-2 3 0v10-7c0-2 3-2 3 0v13c0 6-4 10-9 10h-2c-3 0-5-1-7-4l-5-7c-1-2 1-4 3-3z" fill="#fbf6ee" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M33 20l3-4M38 23l4-2M29 18l-1-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="gift-reveal-text">Tap to send<br />a gift</span></span>
            <span class="gift-reveal-button"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 11.5 21 3l-6.5 18-3-7.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M11.5 13.5 21 3" stroke="currentColor" stroke-width="1.8"/></svg>Transfer here</span>
          </span>
        </button>
        <span class="gift-hearts" aria-hidden="true"><svg viewBox="0 0 80 30" focusable="false"><path d="M4 22c10 0 18-4 24-8M76 22c-10 0-18-4-24-8" fill="none" stroke="currentColor" stroke-width="1"/><path d="M34 20c-6-5-8-9-5-12 2-2 5-1 6 1 1-2 4-3 6-1 3 3 1 7-7 12z" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M44 22c-6-5-8-9-5-12 2-2 5-1 6 1 1-2 4-3 6-1 3 3 1 7-7 12z" fill="none" stroke="currentColor" stroke-width="1.3" opacity=".7"/></svg></span>
      </div>

      <dialog id="gift-dialog" class="gift-dialog" aria-labelledby="gift-dialog-title">
        <div class="gift-dialog-panel">
          <button type="button" class="gift-close" id="gift-close" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <p class="gift-mono small" aria-hidden="true"><i></i><span>{wedding.bride.charAt(0)}<b>&amp;</b>{wedding.groom.charAt(0)}</span><i></i></p>
          <h3 id="gift-dialog-title">Send a gift</h3>
          <p class="gift-dialog-lead">Scan with your banking app, or save the QR image and upload it there.</p>
          <div class="gift-tabs" role="tablist" aria-label="Choose how to send">
            {wedding.giftAccounts.map((a, i) => <button type="button" role="tab" id={`gift-tab-${i}`} aria-controls={`gift-pane-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>{a.label}</button>)}
          </div>
          <!-- Every bank shows the same layout (bank, QR, name), so switching tabs doesn't shift anything. -->
          <div class="gift-panes">
            {wedding.giftAccounts.map((a, i) => (
              <div class="gift-pane" role="tabpanel" id={`gift-pane-${i}`} aria-labelledby={`gift-tab-${i}`} hidden={i !== 0}>
                <div class="gift-qr-card">
                  <p class="gift-bank">{a.label}</p>
                  <img src={a.image} width="600" height="600" alt={`${a.label} QR code for sending a gift to ${wedding.giftRecipient}`} loading="lazy" decoding="async" />
                  <p class="gift-recipient">{wedding.giftRecipient}</p>
                </div>
                <a class="gift-save" href={a.image} download={a.file}>Save QR image <span aria-hidden="true">&darr;</span></a>
              </div>
            ))}
          </div>
          <p class="gift-note">Transfer fees may apply. Thank you for your love and generosity.</p>
        </div>
      </dialog>
    </section>
    <section id="rsvp" class="rsvp rsvp-stack section-pad" aria-labelledby="rsvp-title">
      <div class="rsvp-intro">
        <div class="rsvp-top">
          <div class="rsvp-heading"><span class="eyebrow">RSVP <i aria-hidden="true"></i></span><h2 id="rsvp-title">Will you<br /><em>join us?</em></h2></div>
          <!-- Two round frames; the couple's photos slide through them to the right (rsvp-photos.ts). -->
          <div class="rsvp-photos" role="img" aria-label={`Photos of ${wedding.heroNames[0]} and ${wedding.heroNames[1]}`}>
            {[0, 2].map(start => (
              <div class="photo-ring" data-photos={JSON.stringify(wedding.couplePhotos)} data-start={start}>
                <div class="photo-track"><img src={wedding.couplePhotos[start % wedding.couplePhotos.length]} width="400" height="400" alt="" loading="lazy" decoding="async" /></div>
              </div>
            ))}
          </div>
        </div>
        <p class="rsvp-lead">Your presence would mean the world.<br />Please let us know if you can celebrate with us.</p>
        <p class="deadline">KINDLY RESPOND ON OR BEFORE<br /><span>{wedding.rsvpDeadline}</span></p>
      </div>
      <Orchid id="orchid-rsvp" class="rsvp-orchid" />
      <div class="rsvp-panel">
        <div id="invitation-lookup"><h3>A place just for you</h3><p>Open the personal link {wedding.bride} &amp; {wedding.groom} sent you, or enter your 6-character invitation code below.</p><form id="lookup-form"><label for="invite-code">Invitation code</label><input id="invite-code" name="token" required autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="e.g. K7MP3Q" /><button class="button" type="submit">Find my invitation <span aria-hidden="true">→</span></button></form></div>
        <form id="rsvp-form" hidden>
          <p class="invitation-for">RESERVED WITH LOVE FOR <strong id="household-name"></strong></p>
          <div class="form-row"><div><label for="guest-name">Your name</label><input id="guest-name" name="name" autocomplete="name" maxlength="120" required placeholder="First and last name" /></div><div><label for="guest-email">Email address</label><input id="guest-email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com" /></div></div>
          <fieldset><legend>Will you be joining us?</legend><div class="attendance-options"><label><input type="radio" name="attending" value="yes" required /><span>Joyfully accepts <span aria-hidden="true">↗︎</span></span></label><label><input type="radio" name="attending" value="no" required /><span>Regretfully declines</span></label></div></fieldset>
          <fieldset id="guest-count-field" hidden><legend>Who will be joining us? <span id="guest-allowance"></span></legend><div id="named-guests" class="named-guests"></div><p class="form-privacy">Choose one or both names. Only selected guests will be counted.</p></fieldset>
          <label for="guest-message" id="message-label">A little message for the couple</label><textarea id="guest-message" name="message" required maxlength="2000" rows="4" placeholder="Share a wish, a note, or let us know why you cannot make it…"></textarea>
          <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
          <button type="submit" class="button" id="submit-rsvp">Send with love <span aria-hidden="true">→</span></button><p class="form-privacy">Your response is shared privately with the couple for wedding planning.</p>
        </form>
        <div id="rsvp-success" hidden><span class="success-symbol" aria-hidden="true">♡</span><h3>Received with love.</h3><p id="success-copy"></p><button type="button" class="text-link" id="edit-rsvp">Update my response <span aria-hidden="true">↗︎</span></button></div>
        <p id="form-status" role="status" aria-live="polite"></p>
      </div>
    </section>
    <footer class="site-footer"><span class="eyebrow">WE CAN’T WAIT TO CELEBRATE WITH YOU</span><p>{wedding.bride} <i>&</i> {wedding.groom}</p><span>With full hearts, and all our love.</span><a href="#invitation" class="text-link">Back to the beginning ↑</a></footer>
  </main>
  {wedding.musicUrl && <><audio id="wedding-audio" src={wedding.musicUrl} preload="none" loop></audio><button id="music-toggle" class="music-toggle" aria-label="Play music" aria-pressed="false"><span aria-hidden="true">♫</span><span id="music-label">Play music</span></button></>}
  <noscript><style>.envelope-screen{display:none}</style><div class="noscript-note">Please enable JavaScript to send your RSVP. You can still read the invitation below.</div></noscript>
  <script src="../scripts/invitation.ts"></script>
  <script src="../scripts/countdown.ts"></script>
  <script src="../scripts/film.ts"></script>
  <script src="../scripts/venue-sketch.ts"></script>
  <script src="../scripts/butterflies.ts"></script>
  <script src="../scripts/rsvp-photos.ts"></script>
  <script src="../scripts/gifts.ts"></script>
  <script src="../scripts/film-strip.ts"></script>
</Layout>
