---
import Layout from '../layouts/Layout.astro';
import Botanical from '../components/Botanical.astro';
import VenueSketch from '../components/VenueSketch.astro';
import { wedding } from '../config/wedding';
---
<Layout title={`${wedding.bride} & ${wedding.groom} · A wedding invitation`}>
  <a class="skip-link" href="#invitation">Skip to invitation</a>
  <div class="envelope-screen" id="envelope-screen">
    <span class="eyebrow envelope-heading">A LITTLE SOMETHING, JUST FOR YOU</span>
    <Botanical class="envelope-botanical" />
    <button class="envelope-button" id="open-envelope" aria-label="Open your wedding invitation">
      <span class="envelope-letter"><span class="eyebrow">YOU ARE INVITED</span><span class="letter-names">{wedding.bride}<i>&</i>{wedding.groom}</span></span>
      <span class="envelope-back"></span>
      <span class="envelope-pocket"></span>
      <svg class="envelope-heart" viewBox="0 0 100 90" aria-hidden="true" focusable="false">
        <path class="heart-stroke" pathLength="1" d="M50 81 C 38 70, 13 55, 10 35 C 8 19, 20 8, 32 9 C 42 10, 48 18, 50 28 C 53 18, 60 9, 71 9 C 84 10, 93 21, 90 37 C 87 55, 63 69, 51 80 C 49 82, 46 83, 44 80" />
        <path class="heart-stroke heart-stroke-sketch" pathLength="1" d="M49 78 C 36 67, 15 53, 13 34 C 12 21, 22 12, 33 13 C 42 14, 47 21, 49 30 C 52 21, 60 12, 70 13 C 82 14, 90 24, 87 38 C 84 53, 62 67, 52 77" />
      </svg>
      <span class="envelope-flap"></span>
      <span class="wax-seal">{wedding.bride.slice(0, 1)}<i>&</i>{wedding.groom.slice(0, 1)}</span>
    </button>
    <div class="envelope-caption"><span class="script-caption">An invitation to our forever</span><p>TOUCH THE ENVELOPE TO OPEN</p></div>
    <span class="envelope-footer">WITH LOVE, {wedding.bride.toUpperCase()} & {wedding.groom.toUpperCase()}</span>
  </div>

  <main id="invitation" tabindex="-1">
    {wedding.sampleDetails && <div class="sample-banner">DESIGN PREVIEW · Date, venue, and event details are samples</div>}
    <header class="site-header"><a href="#invitation" class="monogram" aria-label="Back to the beginning">{wedding.bride[0]}<i>&</i>{wedding.groom[0]}</a><nav aria-label="Invitation"><a href="#details">The day</a><a href="#attire">Attire</a><a href="#rsvp" class="nav-rsvp">Kindly RSVP <span aria-hidden="true">↗︎</span></a></nav></header>
    <section class="hero" aria-labelledby="couple-names">
      <Botanical class="hero-flower left" /><Botanical class="hero-flower right" />
      <p class="eyebrow">TOGETHER WITH OUR FAMILIES</p>
      <p class="hero-invitation">You are warmly invited to the wedding of</p>
      <h1 id="couple-names">{wedding.bride}<span class="ampersand">&</span>{wedding.groom}</h1>
      <p class="full-names">{wedding.brideFullName} & {wedding.groomFullName}</p>
      <div class="hero-date"><span class="small-star" aria-hidden="true">✧</span><p>{wedding.date}</p><span class="small-star" aria-hidden="true">✧</span></div>
      <div class="countdown" id="countdown" data-target={wedding.ceremonyStartsAt} role="timer" aria-label={`Countdown to ${wedding.date}`}>
        <div class="countdown-unit"><strong data-unit="days">—</strong><span>Days</span></div>
        <div class="countdown-unit"><strong data-unit="hours">—</strong><span>Hours</span></div>
        <div class="countdown-unit"><strong data-unit="minutes">—</strong><span>Minutes</span></div>
        <div class="countdown-unit"><strong data-unit="seconds">—</strong><span>Seconds</span></div>
      </div>
      <p class="countdown-done" id="countdown-done" hidden>Today, we say <em>I do.</em></p>
      <p class="hero-location">{wedding.venue}</p>
      <a href="#details" class="scroll-cue"><span>THE BEGINNING OF OUR FOREVER</span><span aria-hidden="true">↓</span></a>
    </section>

    <section class="love-note section-pad"><span class="eyebrow">A DAY TO REMEMBER</span><p>Some moments are made<br />more beautiful <em>with you.</em></p><span class="note-copy">As we begin this next chapter, nothing would mean more<br class="desktop-break" /> than having our favourite people by our side.</span><span class="tiny-flower" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/></svg></span></section>
    {wedding.teaserVideoUrl && (
    <section class="teaser section-pad" aria-labelledby="teaser-title">
      <span class="eyebrow">A LITTLE PREVIEW</span>
      <h2 id="teaser-title">Our story, <em>in motion.</em></h2>
      <div class="teaser-player" id="teaser-player" data-state="idle">
        <video id="teaser-video" src={`${wedding.teaserVideoUrl}#t=6`} preload="metadata" playsinline></video>
        <button type="button" class="teaser-start" id="teaser-start" aria-label="Play our teaser video"><span class="teaser-start-icon" aria-hidden="true"></span><span class="teaser-start-label">Watch our teaser</span></button>
        <div class="teaser-controls" id="teaser-controls">
          <button type="button" id="teaser-toggle" aria-label="Pause video"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="icon-pause" d="M8 5h3v14H8zM13 5h3v14h-3z"/><path class="icon-play" d="M8 5v14l11-7z"/></svg></button>
          <button type="button" id="teaser-fullscreen" aria-label="Full screen"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="icon-expand" d="M4 9V4h5v2H6v3zm11-5h5v5h-2V6h-3zM4 15h2v3h3v2H4zm14 0h2v5h-5v-2h3z"/><path class="icon-shrink" d="M7 4h2v5H4V7h3zm8 0h2v3h3v2h-5zM4 15h5v5H7v-3H4zm11 0h5v2h-3v3h-2z"/></svg></button>
          <button type="button" id="teaser-close" aria-label="Close video"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4z"/></svg></button>
        </div>
      </div>
    </section>
    )}

    <section id="details" class="details section-pad" aria-labelledby="details-title">
      <div class="section-intro"><span class="eyebrow">01 / THE CELEBRATION</span><h2 id="details-title">Where our<br /><em>forever begins.</em></h2><p>A little planning for a beautiful day.<br />Here is everything you need to know.</p></div>
      <div class="event-card"><span class="eyebrow">THE WEDDING DAY</span><h3>{wedding.date}</h3><p class="event-time">{wedding.time}</p><div class="fine-rule"></div><h4>{wedding.venue}</h4><p>{wedding.address}</p>{wedding.mapsUrl && <a class="text-link" href={wedding.mapsUrl} target="_blank" rel="noopener noreferrer">View directions <span aria-hidden="true">↗︎</span></a>}<span class="event-card-flower" aria-hidden="true">✧</span></div>
    </section>

    <section id="venue" class="venue section-pad" aria-labelledby="venue-title">
      <span class="eyebrow">THE VENUE</span>
      <h2 id="venue-title">{wedding.venue.split(',')[0]}<em>{wedding.venue.includes(',') ? `, ${wedding.venue.split(',').slice(1).join(',').trim()}` : ''}</em></h2>
      <p class="venue-copy">A Spanish-inspired hacienda in the heart of Cebu City,<br class="desktop-break" /> set among gardens, where we will say our vows.</p>
      <div class="venue-art" id="venue-art"><VenueSketch label={`Pencil-style sketch of ${wedding.venue}`} /></div>
      <button type="button" class="venue-replay" id="venue-replay" hidden><span aria-hidden="true">↻</span> Replay sketch</button>
      <p class="venue-address">{wedding.address}</p>
      <div class="venue-links">
        {wedding.venueUrl && <a class="text-link" href={wedding.venueUrl} target="_blank" rel="noopener noreferrer">Visit {wedding.venue.split(',')[0]} <span aria-hidden="true">↗︎</span></a>}
        {wedding.mapsUrl && <a class="text-link" href={wedding.mapsUrl} target="_blank" rel="noopener noreferrer">View directions <span aria-hidden="true">↗︎</span></a>}
      </div>
    </section>

    <section id="program" class="program section-pad" aria-labelledby="program-title">
      <span class="eyebrow">THE PROGRAM</span>
      <h2 id="program-title">The order <em>of our day.</em></h2>
      <p class="program-date">{wedding.date}</p>
      <ol class="program-list">
        {wedding.program.map(item => (
          <li class="program-item">
            <span class="program-dot" aria-hidden="true"></span>
            <p class="program-time"><time>{item.time}</time><span>{item.period}</span></p>
            <p class="program-title">{item.title}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="attire" class="attire section-pad" aria-labelledby="attire-title"><span class="eyebrow">02 / DRESSED IN LOVE</span><h2 id="attire-title">Soft tones.<br /><em>Beautiful company.</em></h2><p class="attire-code">{wedding.dressCode}</p><p class="attire-note">{wedding.dressNote}</p>
      <div class="attire-carousel" id="attire-carousel" role="region" aria-roledescription="carousel" aria-label="Attire guide">
        <div class="attire-tabs" role="tablist" aria-label="Choose an attire guide">
          {wedding.attireGuides.map((guide, i) => <button type="button" role="tab" class="attire-tab" data-index={i} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`attire-slide-${i}`}>{guide.title}</button>)}
        </div>
        <div class="attire-viewport">
          <button type="button" class="attire-arrow prev" aria-label="Previous attire guide">←</button>
          <div class="attire-track" id="attire-track" tabindex="0">
            {wedding.attireGuides.map((guide, i) => (
              <figure class={`attire-slide${i === 0 ? ' is-active' : ''}`} id={`attire-slide-${i}`} role="tabpanel" aria-roledescription="slide" aria-label={`${i + 1} of ${wedding.attireGuides.length}: ${guide.title}`}>
                <figcaption><span class="eyebrow">ATTIRE GUIDE · {i + 1} / {wedding.attireGuides.length}</span><strong>{guide.title}</strong></figcaption>
                <button type="button" class="attire-zoom" data-index={i} aria-label={`View the ${guide.title} attire guide larger`}>
                  <img src={guide.image} width={guide.width} height={guide.height} alt={guide.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  <span class="attire-zoom-hint" aria-hidden="true">Tap to enlarge ⤢</span>
                </button>
              </figure>
            ))}
          </div>
          <button type="button" class="attire-arrow next" aria-label="Next attire guide">→</button>
        </div>
        <div class="attire-dots" aria-hidden="true">{wedding.attireGuides.map((_, i) => <span data-index={i} class={i === 0 ? 'active' : ''}></span>)}</div>
      </div>
      <dialog class="attire-lightbox" id="attire-lightbox" aria-labelledby="attire-lightbox-title">
        <div class="attire-lightbox-bar"><p><span class="eyebrow">ATTIRE GUIDE</span><strong id="attire-lightbox-title"></strong></p><button type="button" class="text-link" id="attire-lightbox-close">Close ×</button></div>
        <div class="attire-lightbox-frame"><img id="attire-lightbox-image" alt="" /></div>
      </dialog>
    </section>

    <section id="rsvp" class="rsvp section-pad" aria-labelledby="rsvp-title">
      <div class="rsvp-intro"><span class="eyebrow">03 / SAVE YOUR SEAT</span><h2 id="rsvp-title">Will you<br /><em>join us?</em></h2><p>Your presence would mean the world.<br />Please let us know if you can celebrate with us.</p><p class="deadline">KINDLY RESPOND ON OR BEFORE<br /><span>{wedding.rsvpDeadline}</span></p><Botanical class="rsvp-flower" /></div>
      <div class="rsvp-panel">
        <div id="invitation-lookup"><h3>A place just for you</h3><p>Open your personal invitation link, or enter the 4-digit invitation code shared with you.</p><form id="lookup-form"><label for="invite-code">Invitation code</label><input id="invite-code" name="token" required autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="e.g. 4821" /><button class="button" type="submit">Find my invitation <span aria-hidden="true">→</span></button></form>{import.meta.env.DEV && <button type="button" class="text-link preview-form-control" id="preview-form">Preview RSVP form ↗︎</button>}</div>
        <form id="rsvp-form" hidden>
          <p class="invitation-for">RESERVED WITH LOVE FOR <strong id="household-name"></strong></p>
          <div class="form-row"><div><label for="guest-name">Your name</label><input id="guest-name" name="name" autocomplete="name" maxlength="120" required placeholder="First and last name" /></div><div><label for="guest-email">Email address</label><input id="guest-email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com" /></div></div>
          <fieldset><legend>Will you be joining us?</legend><div class="attendance-options"><label><input type="radio" name="attending" value="yes" required /><span>Joyfully accepts <span aria-hidden="true">↗︎</span></span></label><label><input type="radio" name="attending" value="no" required /><span>Regretfully declines</span></label></div></fieldset>
          <fieldset id="guest-count-field" hidden><legend>Who will be joining us? <span id="guest-allowance"></span></legend><div id="named-guests" class="named-guests"></div><p class="form-privacy">Choose one or both names. Only selected guests will be counted.</p></fieldset>
          <label for="guest-message" id="message-label">A little message for the couple</label><textarea id="guest-message" name="message" required maxlength="2000" rows="4" placeholder="Share a wish, a note, or let us know why you cannot make it…"></textarea>
          <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
          <button type="submit" class="button" id="submit-rsvp">Send with love <span aria-hidden="true">→</span></button><p class="form-privacy">Your response is shared privately with the couple for wedding planning.</p>
        </form>
        <div id="rsvp-success" hidden><span class="success-symbol" aria-hidden="true">♡</span><h3>Received with love.</h3><p id="success-copy"></p><button type="button" class="text-link" id="edit-rsvp">Update my response <span aria-hidden="true">↗︎</span></button></div>
        <p id="form-status" role="status" aria-live="polite"></p>
      </div>
    </section>
    <section id="memories-invitation" class="memory-invite section-pad" hidden><span class="eyebrow">OUR DAY, THROUGH YOUR EYES</span><h2>A moment to<br /><em>keep forever.</em></h2><p>We would love to see the celebration through your eyes.<br />Share up to 10 photos each, privately with us.</p><a id="share-memories" class="button" href="/memories">Share your memories <span aria-hidden="true">↗︎</span></a></section>
    <footer class="site-footer"><span class="eyebrow">WE CAN’T WAIT TO CELEBRATE WITH YOU</span><p>{wedding.bride} <i>&</i> {wedding.groom}</p><span>With full hearts, and all our love.</span><a href="#invitation" class="text-link">Back to the beginning ↑</a></footer>
  </main>
  {wedding.musicUrl && <><audio id="wedding-audio" src={wedding.musicUrl} preload="none" loop></audio><button id="music-toggle" class="music-toggle" aria-label="Play music" aria-pressed="false"><span aria-hidden="true">♫</span><span id="music-label">Play music</span></button></>}
  <noscript><style>.envelope-screen{display:none}</style><div class="noscript-note">Please enable JavaScript to send your RSVP. You can still read the invitation below.</div></noscript>
  <script src="../scripts/invitation.ts"></script>
  <script src="../scripts/countdown.ts"></script>
  <script src="../scripts/teaser.ts"></script>
  <script src="../scripts/venue-sketch.ts"></script>
  <script src="../scripts/attire.ts"></script>
</Layout>
