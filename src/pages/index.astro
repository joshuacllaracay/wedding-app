---
import Layout from '../layouts/Layout.astro';
import Botanical from '../components/Botanical.astro';
import { wedding } from '../config/wedding';
---
<Layout title={`${wedding.bride} & ${wedding.groom} · A wedding invitation`}>
  <a class="skip-link" href="#invitation">Skip to invitation</a>
  <div class="envelope-screen" id="envelope-screen">
    <span class="eyebrow envelope-heading">A LITTLE SOMETHING, JUST FOR YOU</span>
    <Botanical class="envelope-botanical" />
    <button class="envelope-button" id="open-envelope" aria-label="Open your wedding invitation">
      <span class="envelope-letter"><span class="eyebrow">YOU ARE INVITED</span><span class="letter-names">{wedding.bride}<i>&</i>{wedding.groom}</span></span>
      <span class="envelope-back"></span>
      <span class="envelope-pocket"></span>
      <span class="envelope-flap"></span>
      <span class="wax-seal">{wedding.bride.slice(0, 1)}<i>&</i>{wedding.groom.slice(0, 1)}</span>
    </button>
    <div class="envelope-caption"><span class="script-caption">An invitation to our forever</span><p>TOUCH THE ENVELOPE TO OPEN</p></div>
    <span class="envelope-footer">WITH LOVE, {wedding.bride.toUpperCase()} & {wedding.groom.toUpperCase()}</span>
  </div>

  <main id="invitation" tabindex="-1">
    {wedding.sampleDetails && <div class="sample-banner">DESIGN PREVIEW · Date, venue, and event details are samples</div>}
    <header class="site-header"><a href="#invitation" class="monogram" aria-label="Back to the beginning">{wedding.bride[0]}<i>&</i>{wedding.groom[0]}</a><nav aria-label="Invitation"><a href="#details">The day</a><a href="#attire">Attire</a><a href="#rsvp" class="nav-rsvp">Kindly RSVP <span aria-hidden="true">↗</span></a></nav></header>
    <section class="hero" aria-labelledby="couple-names">
      <Botanical class="hero-flower left" /><Botanical class="hero-flower right" />
      <p class="eyebrow">TOGETHER WITH OUR FAMILIES</p>
      <p class="hero-invitation">You are warmly invited to the wedding of</p>
      <h1 id="couple-names">{wedding.bride}<span class="ampersand">&</span>{wedding.groom}</h1>
      <p class="full-names">{wedding.brideFullName} & {wedding.groomFullName}</p>
      <div class="hero-date"><span class="small-star" aria-hidden="true">✧</span><p>{wedding.date}</p><span class="small-star" aria-hidden="true">✧</span></div>
      <p class="hero-location">{wedding.venue}</p>
      <a href="#details" class="scroll-cue"><span>THE BEGINNING OF OUR FOREVER</span><span aria-hidden="true">↓</span></a>
    </section>

    <section class="love-note section-pad"><span class="eyebrow">A DAY TO REMEMBER</span><p>Some moments are made<br />more beautiful <em>with you.</em></p><span class="note-copy">As we begin this next chapter, nothing would mean more<br class="desktop-break" /> than having our favourite people by our side.</span><span class="tiny-flower" aria-hidden="true">✳</span></section>

    <section id="details" class="details section-pad" aria-labelledby="details-title">
      <div class="section-intro"><span class="eyebrow">01 / THE CELEBRATION</span><h2 id="details-title">Where our<br /><em>forever begins.</em></h2><p>A little planning for a beautiful day.<br />Here is everything you need to know.</p></div>
      <div class="event-card"><span class="eyebrow">THE WEDDING DAY</span><h3>{wedding.date}</h3><p class="event-time">{wedding.time}</p><div class="fine-rule"></div><h4>{wedding.venue}</h4><p>{wedding.address}</p>{wedding.mapsUrl && <a class="text-link" href={wedding.mapsUrl} target="_blank" rel="noopener noreferrer">View directions <span aria-hidden="true">↗</span></a>}<span class="event-card-flower" aria-hidden="true">✧</span></div>
    </section>

    <section id="attire" class="attire section-pad" aria-labelledby="attire-title"><span class="eyebrow">02 / DRESSED IN LOVE</span><h2 id="attire-title">Soft tones.<br /><em>Beautiful company.</em></h2><p class="attire-code">{wedding.dressCode}</p><p class="attire-note">{wedding.dressNote}</p><div class="palette">{wedding.palette.map(color => <div class="swatch"><span style={`--swatch: ${color.hex}`} aria-hidden="true"></span><p>{color.name}</p><small>{color.hex}</small></div>)}</div><p class="palette-footnote">Our wedding palette · a little inspiration for your outfit</p></section>

    <section id="rsvp" class="rsvp section-pad" aria-labelledby="rsvp-title">
      <div class="rsvp-intro"><span class="eyebrow">03 / SAVE YOUR SEAT</span><h2 id="rsvp-title">Will you<br /><em>join us?</em></h2><p>Your presence would mean the world.<br />Please let us know if you can celebrate with us.</p><p class="deadline">KINDLY REPLY BY<br /><span>{wedding.rsvpDeadline}</span></p><Botanical class="rsvp-flower" /></div>
      <div class="rsvp-panel">
        <div id="invitation-lookup"><h3>A place just for you</h3><p>Open your personal invitation link, or enter the invitation code shared with you.</p><form id="lookup-form"><label for="invite-code">Invitation code</label><input id="invite-code" name="token" required autocomplete="off" placeholder="Your private invitation code" /><button class="button" type="submit">Find my invitation <span aria-hidden="true">→</span></button></form>{import.meta.env.DEV && <button type="button" class="text-link preview-form-control" id="preview-form">Preview RSVP form ↗</button>}</div>
        <form id="rsvp-form" hidden>
          <p class="invitation-for">RESERVED WITH LOVE FOR <strong id="household-name"></strong></p>
          <div class="form-row"><div><label for="guest-name">Your name</label><input id="guest-name" name="name" autocomplete="name" maxlength="120" required placeholder="First and last name" /></div><div><label for="guest-email">Email address</label><input id="guest-email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com" /></div></div>
          <fieldset><legend>Will you be joining us?</legend><div class="attendance-options"><label><input type="radio" name="attending" value="yes" required /><span>Joyfully accepts <span aria-hidden="true">↗</span></span></label><label><input type="radio" name="attending" value="no" required /><span>Regretfully declines</span></label></div></fieldset>
          <fieldset id="guest-count-field" hidden><legend>Who will be joining us? <span id="guest-allowance"></span></legend><div id="named-guests" class="named-guests"></div><p class="form-privacy">Choose one or both names. Only selected guests will be counted.</p></fieldset>
          <label for="guest-message" id="message-label">A little message for the couple</label><textarea id="guest-message" name="message" required maxlength="2000" rows="4" placeholder="Share a wish, a note, or let us know why you cannot make it…"></textarea>
          <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
          <button type="submit" class="button" id="submit-rsvp">Send with love <span aria-hidden="true">→</span></button><p class="form-privacy">Your response is shared privately with the couple for wedding planning.</p>
        </form>
        <div id="rsvp-success" hidden><span class="success-symbol" aria-hidden="true">♡</span><h3>Received with love.</h3><p id="success-copy"></p><button type="button" class="text-link" id="edit-rsvp">Update my response <span aria-hidden="true">↗</span></button></div>
        <p id="form-status" role="status" aria-live="polite"></p>
      </div>
    </section>
    <section id="memories-invitation" class="memory-invite section-pad" hidden><span class="eyebrow">OUR DAY, THROUGH YOUR EYES</span><h2>A moment to<br /><em>keep forever.</em></h2><p>We would love to see the celebration through your eyes.<br />Share up to 10 photos each, privately with us.</p><a id="share-memories" class="button" href="/memories">Share your memories <span aria-hidden="true">↗</span></a></section>
    <footer class="site-footer"><span class="eyebrow">WE CAN’T WAIT TO CELEBRATE WITH YOU</span><p>{wedding.bride} <i>&</i> {wedding.groom}</p><span>With full hearts, and all our love.</span><a href="#invitation" class="text-link">Back to the beginning ↑</a></footer>
  </main>
  {wedding.musicUrl && <><audio id="wedding-audio" src={wedding.musicUrl} preload="none" loop></audio><button id="music-toggle" class="music-toggle" aria-label="Play music" aria-pressed="false"><span aria-hidden="true">♫</span><span id="music-label">Play music</span></button></>}
  <noscript><style>.envelope-screen{display:none}</style><div class="noscript-note">Please enable JavaScript to send your RSVP. You can still read the invitation below.</div></noscript>
  <script src="../scripts/invitation.ts"></script>
</Layout>
